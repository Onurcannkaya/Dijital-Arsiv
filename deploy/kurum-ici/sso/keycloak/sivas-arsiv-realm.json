{
  "realm": "sivas-arsiv",
  "displayName": "Sivas Belediyesi Dijital Arşiv",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": true,
  "clients": [
    {
      "clientId": "arsiv-vekil",
      "name": "Sivas Arşiv Ters Vekili (oauth2-proxy)",
      "description": "Kimlik sınırı vekilinin OIDC istemcisi; kullanıcıya görünmez.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "secret": "PILOT-ICIN-DEGISTIR-openssl-rand-hex-32",
      "redirectUris": [
        "https://arsiv.sivas.bel.tr/oauth2/callback",
        "http://127.0.0.1:8080/oauth2/callback"
      ],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      }
    }
  ]
}
