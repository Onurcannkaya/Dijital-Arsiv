# Kurum içi yığın ortamı — bu dosya .env olarak kopyalanır ve DOLDURULUR.
# .env sürüm kontrolüne GİRMEZ (CI sır sızıntısı bekçisi vardır).
# Sır üretimi için: openssl rand -hex 32

# MinIO kök yöneticisi (yalnız kurulum/işletim; uygulama bunu KULLANMAZ)
MINIO_ROOT_USER=arsiv-yonetici
MINIO_ROOT_PASSWORD=

# Uygulamanın MinIO kimliği (minio-init bu kullanıcıyı oluşturur; üretimde
# rol-başına dar politika ile değiştirilmelidir — README §IAM)
ARCHIVE_S3_ACCESS_KEY_ID=arsiv-uygulama
ARCHIVE_S3_SECRET_ACCESS_KEY=

# Uygulama
ARCHIVE_CANONICAL_HOST=arsiv.sivas.bel.tr
ARCHIVE_ADMIN_EMAILS=bilgiislemyonetici@sivas.bel.tr
ARCHIVE_MIGRATION_TOKEN=
APP_ENV=staging
# Yalnız kabul koşusu ortamında doldurulur; üretimde boş bırakılır.
ARCHIVE_ACCEPTANCE_TOKEN=

# Servis jetonları (her biri ayrı, >= 32 karakter)
CONTENT_SCAN_SERVICE_TOKEN=
OCR_SERVICE_TOKEN=
DOCUMENT_RENDER_SERVICE_TOKEN=
# Render imaj özeti: docker inspect ile alınan sha256:... değeri (ADR-015 kanıtı)
DOCUMENT_RENDER_IMAGE_DIGEST=

# Ters vekilin makinede dinleyeceği port
ARCHIVE_PROXY_PORT=8080

# --- SSO kaplaması (docker-compose.sso.yml) ---
# Kabul geçidi jetonu (>= 32 karakter; boşsa vekil bilinçli olarak açılmaz).
# Üretimde rastgele tutulur ve KİMSEYE dağıtılmaz; staging kabul koşusunda
# GitHub secret ACCEPTANCE_PROXY_TOKEN ile AYNI değer olmalıdır.
ACCEPTANCE_PROXY_TOKEN=
SSO_ISSUER_URL=https://kimlik.sivas.bel.tr/realms/sivas-arsiv
SSO_CLIENT_ID=arsiv-vekil
SSO_CLIENT_SECRET=
SSO_COOKIE_SECRET=
SSO_REDIRECT_URL=https://arsiv.sivas.bel.tr/oauth2/callback
SSO_EMAIL_DOMAINS=sivas.bel.tr
SSO_COOKIE_SECURE=true

# Yalnız pilot Keycloak profili (--profile kimlik-yerel)
KEYCLOAK_ADMIN_USER=kimlik-yonetici
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_PORT=8081
