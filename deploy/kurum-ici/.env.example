# Kurum içi yığın ortamı — bu dosya .env olarak kopyalanır ve DOLDURULUR.
# .env sürüm kontrolüne GİRMEZ (CI sır sızıntısı bekçisi vardır).
# Sır üretimi için: openssl rand -hex 32

# Korumalı staging/production dağıtımında dış imajların tamamı değişmez özetle
# sabitlenir. Yerel pilot boş bırakabilir; CI dağıtımı repo@sha256:64-hex ister.
MINIO_SERVER_IMAGE=
MINIO_CLIENT_IMAGE=
NGINX_IMAGE=
OAUTH2_PROXY_IMAGE=
LITESTREAM_IMAGE=
# Yalnız kimlik-yerel pilot profili kullanılacaksa doldurulur.
KEYCLOAK_IMAGE=

# MinIO kök yöneticisi (yalnız kurulum/işletim; uygulama bunu KULLANMAZ)
MINIO_ROOT_USER=arsiv-yonetici
MINIO_ROOT_PASSWORD=

# Uygulamanın MinIO kimliği (asıl silme/retention yönetimi YOK)
ARCHIVE_S3_ACCESS_KEY_ID=arsiv-uygulama
ARCHIVE_S3_SECRET_ACCESS_KEY=

# Servis başına dar MinIO kimlikleri; dört sırın tamamı birbirinden farklıdır.
CONTENT_SCAN_S3_ACCESS_KEY_ID=arsiv-tarayici
CONTENT_SCAN_S3_SECRET_ACCESS_KEY=
OCR_S3_ACCESS_KEY_ID=arsiv-ocr
OCR_S3_SECRET_ACCESS_KEY=
DOCUMENT_RENDER_S3_ACCESS_KEY_ID=arsiv-render
DOCUMENT_RENDER_S3_SECRET_ACCESS_KEY=

# STAGING sentetik belge süresi. Üretimde bu değeri kurum dosya planındaki
# ONAYLI süreyle değiştirin ve onay işaretini açın; teknik ekip süre uydurmaz.
ARCHIVE_WORM_RETENTION_MODE=COMPLIANCE
ARCHIVE_WORM_RETENTION_DURATION=1d
ARCHIVE_WORM_POLICY_APPROVED=
# Production: kurul/tutanak/karar kimliği; süreyi uydurmak yerine izine bağlar.
ARCHIVE_WORM_POLICY_REFERENCE=

# Uygulama
ARCHIVE_CANONICAL_HOST=arsiv.sivas.bel.tr
ARCHIVE_ADMIN_EMAILS=bilgiislemyonetici@sivas.bel.tr
ARCHIVE_MIGRATION_TOKEN=
APP_ENV=staging
# Yalnız kabul koşusu ortamında doldurulur; üretimde boş bırakılır.
ARCHIVE_ACCEPTANCE_TOKEN=

# --- İkinci hata alanı: nesne yedeği, alarm ve kapasite ---
# Üretimde HTTPS uç ile birincilden farklı kimlik/sır zorunludur.
ARCHIVE_S3_BUCKET_BACKUP=
# ör. https://yedek-nesne.sivas.bel.tr
ARCHIVE_BACKUP_S3_ENDPOINT=
ARCHIVE_BACKUP_S3_REGION=auto
ARCHIVE_BACKUP_S3_ACCESS_KEY_ID=arsiv-yedek-yazici
ARCHIVE_BACKUP_S3_SECRET_ACCESS_KEY=
# Yalnız staging'deki izole ağ hedefi için; üretimde boş kalmalıdır.
ARCHIVE_BACKUP_S3_ALLOW_HTTP=
ARCHIVE_BACKUP_S3_SESSION_TOKEN=
ARCHIVE_STORAGE_QUOTA_GB=
# ör. https://alarm.sivas.bel.tr/hooks/dijital-arsiv
ALARM_WEBHOOK_URL=
ALARM_WEBHOOK_TOKEN=

# --- SQLite sürekli PITR (yalnız `pitr` profili) ---
# Üretimde COMPOSE_PROFILES=pitr olmalıdır. Hedef, birincil MinIO ve API
# makinesinden bağımsız hata alanında olmalıdır.
COMPOSE_PROFILES=
# ör. https://yedek-sqlite.sivas.bel.tr
SQLITE_PITR_S3_ENDPOINT=
SQLITE_PITR_S3_BUCKET=
SQLITE_PITR_S3_PREFIX=sivas-arsiv
SQLITE_PITR_S3_REGION=auto
SQLITE_PITR_S3_ACCESS_KEY_ID=sqlite-pitr-yazici
SQLITE_PITR_S3_SECRET_ACCESS_KEY=
# ör. https://alarm.sivas.bel.tr/heartbeat/sqlite-pitr
SQLITE_PITR_HEARTBEAT_URL=
# Temsili boyutta geri yükleme tatbikatı kanıtı görülmeden üretim açılmaz.
SQLITE_PITR_RESTORE_DRILL_APPROVED=

# Servis jetonları (her biri ayrı, >= 32 karakter)
CONTENT_SCAN_SERVICE_TOKEN=
OCR_SERVICE_TOKEN=
DOCUMENT_RENDER_SERVICE_TOKEN=
# Render imaj özeti: docker inspect ile alınan sha256:... değeri (ADR-015 kanıtı)
DOCUMENT_RENDER_IMAGE_DIGEST=

# Ters vekilin makinede dinleyeceği port
ARCHIVE_PROXY_PORT=8080

# --- SSO kaplaması (docker-compose.sso.yml) ---
# Kabul geçidi yalnız staging'de enabled olur ve jeton >= 32 karakterdir.
# Production'da değerler sırasıyla disabled ve BOŞ olmak zorundadır.
ARCHIVE_ACCEPTANCE_BYPASS_ENABLED=enabled
ACCEPTANCE_PROXY_TOKEN=
SSO_ISSUER_URL=https://kimlik.sivas.bel.tr/realms/sivas-arsiv
SSO_CLIENT_ID=arsiv-vekil
SSO_CLIENT_SECRET=
SSO_COOKIE_SECRET=
SSO_REDIRECT_URL=https://arsiv.sivas.bel.tr/oauth2/callback
SSO_EMAIL_DOMAINS=sivas.bel.tr
SSO_COOKIE_SECURE=true
SSO_ALLOWED_REDIRECT_DOMAINS=.sivas.bel.tr
ARCHIVE_EXTERNAL_SCHEME=https

# --- TLS kaplaması (docker-compose.tls.yml) ---
# Kurum runner'ındaki mutlak, salt-okunur dosya yolları.
ARCHIVE_TLS_CERT_FILE=/etc/sivas-arsiv/tls/fullchain.pem
ARCHIVE_TLS_KEY_FILE=/etc/sivas-arsiv/tls/privkey.pem
ARCHIVE_TLS_PORT=443

# Yalnız pilot Keycloak profili (--profile kimlik-yerel)
KEYCLOAK_ADMIN_USER=kimlik-yonetici
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_PORT=8081

# --- Kaynak ve süreç sınırları ---
# Bunlar üst sınırlardır, rezervasyon değildir. K-6 staging ölçümünden sonra
# kurum donanımına göre değiştirilebilir.
MINIO_MEMORY_LIMIT=4g
MINIO_CPU_LIMIT=2.0
API_MEMORY_LIMIT=2g
API_MEMORY_LIMIT_BYTES=2147483648
API_CPU_LIMIT=2.0
CONTENT_SCAN_MEMORY_LIMIT=4g
CONTENT_SCAN_CPU_LIMIT=2.0
OCR_MEMORY_LIMIT=8g
OCR_CPU_LIMIT=4.0
OCR_MAX_REQUESTS=100
DOCUMENT_RENDER_MEMORY_LIMIT=4g
DOCUMENT_RENDER_CPU_LIMIT=2.0
UI_MEMORY_LIMIT=512m
UI_CPU_LIMIT=0.5
PROXY_MEMORY_LIMIT=256m
PROXY_CPU_LIMIT=0.5
OAUTH2_PROXY_MEMORY_LIMIT=512m
OAUTH2_PROXY_CPU_LIMIT=0.5
TLS_EDGE_MEMORY_LIMIT=256m
TLS_EDGE_CPU_LIMIT=0.5
LITESTREAM_MEMORY_LIMIT=512m
LITESTREAM_CPU_LIMIT=0.5
