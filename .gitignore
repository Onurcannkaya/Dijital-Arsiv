# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# Python runtime artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.venv/

# Local/private pilot documents
/test_belge.jpeg
/private-pilot-documents/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Cloudflare yerel gizli değişkenleri (OCR ve göç anahtarları) — asla commit edilmez
.dev.vars
.dev.vars.*

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/outputs/
/work/
*.tsbuildinfo

# kurum içi yığın sırları
deploy/kurum-ici/.env

# lokal geliştirme durumu (LOKAL_GELISTIRME.md)
/data/
