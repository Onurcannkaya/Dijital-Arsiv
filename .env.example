APP_ENV=development
CONTENT_SCAN_SERVICE_URL=http://127.0.0.1:8091
# Zorunlu: tarama servisi anahtarsız çalışmaz; uygulamadaki değerle aynı olmalıdır.
CONTENT_SCAN_SERVICE_TOKEN=yerel-pilotta-degistirin
OCR_SERVICE_URL=http://127.0.0.1:8090
# Zorunlu: tanımlı değilse OCR servisi /v1/ocr isteklerini 503 ile reddeder.
OCR_SERVICE_TOKEN=yerel-pilotta-degistirin
ARCHIVE_ADMIN_EMAILS=arsiv.yoneticisi@sivas.bel.tr
# Şema göç uç noktasının anahtarı (en az 16 karakter). Tanımlı değilse
# POST /api/admin/migrate kapalıdır; localhost dışında şema kendiliğinden
# uygulanmaz ve istekler 503 döner.
ARCHIVE_MIGRATION_TOKEN=yerel-pilotta-degistirin-en-az-16-karakter
# Yalnız CI/CD dağıtım doğrulayıcısı tarafından kullanılır.
DEPLOY_BASE_URL=http://127.0.0.1:3000
PADDLEOCR_DEVICE=cpu
PADDLEOCR_ENABLE_MKLDNN=false
PADDLEOCR_CPU_THREADS=4
PADDLEOCR_DET_LIMIT_SIDE_LEN=1600
PADDLEOCR_REC_SCORE_THRESH=0.35
PADDLEOCR_PREPROCESS=auto

# --- ADR-017 yedekleme (tanımlı değilse yedekleme kapalıdır ve pano bunu söyler) ---
# İkinci hata alanındaki yedek kovası. Ayrı uç/kimlik verilmezse birincil
# S3 ayarları kullanılır; o durumda "ikinci hata alanı ve ayrı yönetim
# kimliği" şartı (ADR-017) KARŞILANMAZ — üretimde ayrı uç ve kimlik verin.
#ARCHIVE_S3_BUCKET_BACKUP=arsiv-yedek
#ARCHIVE_BACKUP_S3_ENDPOINT=https://yedek-minio.kurum.local
#ARCHIVE_BACKUP_S3_ACCESS_KEY_ID=
#ARCHIVE_BACKUP_S3_SECRET_ACCESS_KEY=
#ARCHIVE_BACKUP_S3_REGION=auto
#ARCHIVE_BACKUP_S3_ALLOW_HTTP=

# --- Alarm taşıyıcısı (tanımlı değilse kritik olaylar yalnız log'da kalır) ---
# Kritik işletim olayları (bütünlük bulgusu, OCR dead-letter artışı, yedek
# arızası) bu uca JSON POST edilir; kurumun Teams/Slack köprüsü veya alarm
# toplayıcısı olabilir.
#ALARM_WEBHOOK_URL=https://alarm.kurum.local/webhook
#ALARM_WEBHOOK_TOKEN=
