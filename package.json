{
    "name": "sivas-belediyesi-dijital-arsiv",
    "version": "0.1.0",
    "private": true,
    "engines": {
        "node": ">=22.18.0"
    },
    "scripts": {
        "dev": "vinext dev",
        "dev:hizmetler": "node scripts/dev-stack.mjs",
        "build": "vinext build",
        "start": "vinext start",
        "test": "npm run build && node --test \"tests/*.test.mjs\" \"tests/*.test.ts\"",
        "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .wrangler --ignore-pattern outputs --ignore-pattern work --ignore-pattern .claude",
        "typecheck": "tsc --noEmit",
        "verify": "npm run typecheck && npm run lint && npm test",
        "deploy:staging": "wrangler deploy --env staging",
        "deploy:production": "wrangler deploy --env production",
        "deploy:rollback": "wrangler rollback --env \"${DEPLOY_ENV:-staging}\" --yes --message \"${ROLLBACK_MESSAGE:-deploy gate failed}\"",
        "deploy:verify": "node scripts/verify-deployment.mjs",
        "start:node": "node server/main.ts",
        "db:generate": "drizzle-kit generate"
    },
    "dependencies": {
        "drizzle-orm": "0.45.2",
        "lucide-react": "^0.468.0",
        "next": "16.3.2",
        "react": "19.2.8",
        "react-dom": "19.2.8"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "1.53.1",
        "@cloudflare/workers-types": "5.20260825.1",
        "@tailwindcss/postcss": "4.2.1",
        "@types/node": "22.19.19",
        "@types/react": "19.2.14",
        "@types/react-dom": "19.2.3",
        "@vitejs/plugin-react": "6.0.2",
        "@vitejs/plugin-rsc": "0.5.26",
        "drizzle-kit": "0.31.10",
        "eslint": "9.39.4",
        "eslint-config-next": "16.3.2",
        "react-server-dom-webpack": "19.2.8",
        "tailwindcss": "4.2.1",
        "typescript": "5.9.3",
        "vinext": "0.0.50",
        "vite": "8.2.2",
        "wrangler": "4.125.0"
    },
    "type": "module"
}
